---
import Site from '../layouts/Site.astro';
import BenchmarkSection from '../components/BenchmarkSection.astro';
import Icon from '../components/Icon.astro';
import SolveSpotlight from '../components/SolveSpotlight.astro';
import { readBenchmarkSets } from '../lib/benchmarks';
import { path } from '../lib/site';

const sets = readBenchmarkSets(import.meta.glob('../../data/benchmarks/*.json', { eager: true, import: 'default' }));
const latest = sets[0];
const published = new Intl.DateTimeFormat('en-US', { dateStyle: 'long', timeZone: 'UTC' });
const reportDate = (date: string) => published.format(new Date(date));
---
<Site title="GoHarness Benchmarks" description="Published solve rates, token usage, and harness measurements for GoHarness, the local-first coding agent." page="benchmarks">
  <section class="shell overview">
    <div class="overview-copy">
      <h1>GoHarness<br />benchmarks</h1>
      <p>GoHarness is a local-first coding agent written in Go. Run it in a terminal, in scripts, or from your editor.</p>
      <a class="button primary" href={path('downloads/')}><Icon name="download" size={19} /> Desktop downloads</a>
    </div>
    <SolveSpotlight report={latest} />
  </section>
  <div class="shell reports" id="benchmark-results">
    <h2 class="visually-hidden">Benchmark results</h2>
    {sets.length > 1 && <nav class="report-archive" aria-label="Benchmark reports">
      {sets.map((set) => <a href={`#${set.id}`}>{set.title}</a>)}
    </nav>}
    {sets.map((set) => <article class="benchmark-set" id={set.id} aria-labelledby={`${set.id}-title`}>
      <header class="set-header">
        <h3 id={`${set.id}-title`}>{set.title}</h3>
        <time datetime={set.published}>{reportDate(set.published)}</time>
      </header>
      <nav class="jump-nav" aria-label={`Sections in ${set.title}`}>
        {set.sections.map((section) => <a href={`#${set.id}-${section.id}`}>{section.title}</a>)}
      </nav>
      {set.sections.map((section) => <BenchmarkSection section={section} anchor={`${set.id}-${section.id}`} />)}
    </article>)}
  </div>
</Site>
