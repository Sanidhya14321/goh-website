---
import { Image } from 'astro:assets';
import terminal from '../assets/goh-terminal.png';
import Site from '../layouts/Site.astro';
import Icon from '../components/Icon.astro';
import { path, siteRoutes, taggedSource, upstream, userGuide } from '../lib/site';

const features = [
  {
    title: 'See the check behind a change',
    description: 'GoHarness records whether the run changed files, which check ran, and how it finished. Configure your own test or build command and let the agent attempt a repair if it fails.',
    link: path(siteRoutes.verification),
    label: 'How verification works',
  },
  {
    title: 'Review proposed edits and tool actions',
    description: 'Inspect an edit’s diff or a shell command’s working directory before deciding whether to approve it. Choose how much GoHarness can do automatically in a session, project, or specific folder.',
    link: path(siteRoutes.verification) + '#access-settings',
    label: 'Permissions and access settings',
  },
  {
    title: 'Resume work from a local journal',
    description: 'Reopen an earlier session, branch a conversation, export a transcript, or recover readable history from a damaged journal. Interrupted tools require review before you continue.',
    link: `${userGuide}#sessions-and-recovery`,
    label: 'Sessions and recovery',
  },
  {
    title: 'Choose how to run it',
    description: 'Work interactively in the terminal, stream versioned events from the CLI or local HTTP API, or connect through Agent Client Protocol.',
    link: `${taggedSource}/README.md#interfaces`,
    label: 'GoHarness interfaces',
  },
];
---
<Site title="GoHarness | Local-first coding agent" description="Run GoHarness locally, review proposed changes, and inspect the checks behind each coding task." page="home">
  <section class="shell overview home-overview">
    <div class="overview-copy">
      <h1>Resolve coding tasks with checks you can inspect.</h1>
      <p class="hero-detail">GoHarness is an open-source coding agent that runs on your machine. Open it in a terminal, run it from a script, or connect an editor through ACP. Choose a hosted model provider or a local Ollama model. Review proposed edits and see the checks behind each run’s outcome.</p>
      <div class="hero-actions">
        <a class="button primary" href={path(siteRoutes.start)}>Get started</a>
        <a href={path(siteRoutes.downloads) + '#cli'}>Download the CLI</a>
      </div>
    </div>
    <figure class="terminal-demo">
      <figcaption><Icon name="terminal" size={17} /> GoHarness terminal interface</figcaption>
      <Image src={terminal} widths={[480, 680, 1000, 1240]} sizes="(max-width: 768px) 100vw, 575px" alt="GoHarness terminal session showing an approved file edit and a passing verification check." loading="eager" fetchpriority="high" format="webp" />
    </figure>
  </section>

  <section class="shell home-section" aria-labelledby="capabilities">
    <h2 id="capabilities">How GoHarness works</h2>
    <div class="feature-list">
      {features.map(({ title, description, link, label }) => <div class="feature">
        <h3>{title}</h3>
        <p>{description}</p>
        <a href={link}>{label}</a>
      </div>)}
    </div>
  </section>

  <section class="shell home-section home-pair" aria-label="Try GoHarness and see the benchmarks">
    <div>
      <h2>Review a fix from prompt to check</h2>
      <p>Ask GoHarness to investigate a failing test. Review the proposed patch, approve it, then inspect the recorded check and outcome.</p>
      <ul class="text-links">
        <li><a href={`${taggedSource}/docs/images/tui-session.png`}>Session screenshot</a></li>
        <li><a href={`${taggedSource}/docs/images/tui-approval.png`}>Approval screenshot</a></li>
        <li><a href={`${taggedSource}/docs/images/tui-palette.png`}>Command palette screenshot</a></li>
      </ul>
    </div>
    <div id="benchmark-results">
      <h2>Benchmark results</h2>
      <p>On seven matched prompts, mean input fell from <strong>11.9k to 9.8k tokens per attempt</strong> in the comparison for GoHarness 1.1.0. The report records the model, task sets, and how each result was measured.</p>
      <ul class="text-links">
        <li><a href={path(siteRoutes.benchmarks)}>See the benchmarks</a></li>
        <li><a href={upstream}>View the source</a></li>
      </ul>
    </div>
  </section>
</Site>
