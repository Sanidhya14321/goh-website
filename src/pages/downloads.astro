---
import { readFile } from 'node:fs/promises';
import Site from '../layouts/Site.astro';
import Icon from '../components/Icon.astro';
import { cliInstall, cliRelease } from '../lib/site';
import { configSchema, packageLinks, packages, readCatalog } from '../lib/downloads';
import catalogData from '../../data/downloads.json';
import configData from '../../data/desktop-config.json';

const config = configSchema.parse({ ...configData, repository: process.env.DESKTOP_RELEASE_REPO || configData.repository });
const catalogOverride = process.env.GOH_DOWNLOAD_CATALOG;
const catalog = readCatalog(catalogOverride ? JSON.parse(await readFile(catalogOverride, 'utf8')) : catalogData, config);
const complete = catalog.status === 'complete';
const platformInfo = [
  { id: 'macos', name: 'macOS', instruction: 'Open the DMG and drag GoHarness into Applications.' },
  { id: 'ubuntu', name: 'Ubuntu', instruction: 'Open the DEB with your package installer, or run apt from the download folder with the file you chose.' },
  { id: 'windows', name: 'Windows', instruction: 'Open the EXE installer and follow the setup prompts.' },
] as const;
const mib = new Intl.NumberFormat('en-US', { maximumFractionDigits: 1 });
---
<Site title="Download GoHarness Desktop" description="Find GoHarness Desktop packages for macOS, Ubuntu, and Windows." page="downloads">
  <section class="shell download-intro">
    <div>
      <h1>Download<br />GoHarness Desktop</h1>
      <p>Choose a package for your operating system and processor.</p>
    </div>
    <aside class:list={['release-status', { ready: complete }]} aria-labelledby="release-status-title">
      <h2 id="release-status-title"><span class="status-dot" aria-hidden="true"></span>{complete ? 'Stable desktop packages available' : 'Desktop downloads unavailable'}</h2>
      {catalog.status === 'absent' && <p>There is no public stable desktop release yet.</p>}
      {catalog.status === 'partial' && <p>The latest stable release is missing required packages. Downloads will open when the release is complete.</p>}
      {complete ? <p>The download buttons point to the latest stable release on GitHub.</p> : <a href="#cli">Get the GoHarness CLI</a>}
    </aside>
  </section>
  <div class="shell downloads">
    <nav class="jump-nav" aria-label="Operating systems">
      {platformInfo.map(({ id, name }) => <a href={`#${id}`}>{name}</a>)}
    </nav>
    {platformInfo.map(({ id, name, instruction }) => (
      <section class="platform-row" id={id} aria-labelledby={`${id}-title`}>
        <h2 id={`${id}-title`}><Icon name={id} size={24} />{name}</h2>
        <ul class="package-list">
          {packages.filter((item) => item.platform === id).map((item) => {
            const asset = complete ? catalog.assets.find(({ variant }) => variant === item.id) : undefined;
            const links = complete && asset ? packageLinks(catalog.repository, catalog.tag, item.name) : undefined;
            return (
              <li>
                <div class="package-title"><strong>{item.arch}</strong><span>.{item.format.toLowerCase()}</span></div>
                {links && asset && complete ? (
                  <>
                    <a class="button primary package-button" href={links.latest} aria-label={`Download ${name} · ${item.arch}`}><Icon name="download" size={17} /> Download</a>
                    <div class="asset-meta">
                      <a href={links.pinned}>{catalog.tag} · {asset.bytes >= 1048576 ? `${mib.format(asset.bytes / 1048576)} MiB` : `${asset.bytes.toLocaleString('en-US')} bytes`}</a>
                      {asset.digest && <details><summary>SHA-256</summary><code class="disclosure-content">{asset.digest.split(':')[1]}</code></details>}
                    </div>
                  </>
                ) : <span class="package-unavailable">{complete ? 'Unavailable in this release' : 'Unavailable'}</span>}
              </li>
            );
          })}
        </ul>
        <div class="install">
          <h3>Install</h3><p>{instruction}</p>
          {id === 'ubuntu' && <code class="install-command">sudo apt install ./&lt;package&gt;.deb</code>}
        </div>
      </section>
    ))}
    <aside class="cli-download" id="cli" aria-labelledby="cli-title">
      <div>
        <h2 id="cli-title"><Icon name="terminal" size={27} />GoHarness CLI</h2>
        <p>Run GoHarness in your terminal on macOS, Linux, or Windows.</p>
      </div>
      <div class="cli-actions"><a class="button" href={cliRelease}>CLI release assets</a><a href={cliInstall}>CLI install guide</a></div>
    </aside>
  </div>
</Site>
