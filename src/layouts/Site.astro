---
import config from '../../vercel.json';
import Metadata from '../components/Metadata.astro';
import Icon from '../components/Icon.astro';
import { path, siteRoutes, upstream, type SitePage } from '../lib/site';
import '@fontsource/barlow/latin-400.css';
import '@fontsource/barlow/latin-600.css';
import '@fontsource/barlow/latin-700.css';
import '@fontsource/barlow-condensed/latin-600.css';
import '../styles/site.css';

const { title, description, page } = Astro.props as { title: string; description: string; page: SitePage };
const interactive = page === 'start' || page === 'benchmarks';
const scriptIntegrity = config.headers.flatMap(({ headers }) => headers)
  .find(({ key }) => key === 'Content-Security-Policy')?.value.match(/script-src '(sha384-[^']+)'/)?.[1];
if (interactive && !scriptIntegrity) throw new Error('Missing CSP hash for interactions.js');
const navigation = [
  { key: 'start', label: 'Get started' },
  { key: 'downloads', label: 'Downloads' },
  { key: 'verification', label: 'Verification' },
  { key: 'benchmarks', label: 'Benchmarks' },
] as const;
---
<!doctype html>
<html lang="en">
  <head>
    <Metadata {title} {description} {page} />
    {interactive && <script is:inline src={path('interactions.js')} integrity={scriptIntegrity} defer></script>}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href={path()} aria-label="GoHarness Website beta home"><span class="brand-mark"><Icon name="terminal" size={19} /></span>GoHarness <span class="site-beta">Website beta</span></a>
        <nav aria-label="Main navigation">
          {navigation.map(({ key, label }) => <a href={path(siteRoutes[key])} aria-current={page === key ? 'page' : undefined}>{label}</a>)}
        </nav>
        <a class="header-repo" href={upstream} aria-label="GoHarness on GitHub"><Icon name="github" size={19} /><span>GitHub</span></a>
      </div>
    </header>
    <main id="main" tabindex="-1"><slot /></main>
    <footer class="site-footer">
      <div class="shell footer-inner">
        <a class="brand" href={path()}><span class="brand-mark"><Icon name="terminal" size={17} /></span>GoHarness</a>
        <div><a href={path('downloads/')}>Downloads</a><a href={upstream}>Source on GitHub</a></div>
        <p class="site-status">GoHarness website beta</p>
      </div>
    </footer>
  </body>
</html>
