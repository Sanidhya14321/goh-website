---
interface Props {
  name: 'terminal' | 'download' | 'github' | 'macos' | 'ubuntu' | 'windows';
  size?: number;
}
const { name, size = 20 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 24 24" fill="none" aria-hidden="true" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
  {name === 'terminal' && <path d="m5 6 5 6-5 6m9 0h5"/>}
  {name === 'download' && <path d="M12 3v12m-4-4 4 4 4-4M4 16v4h16v-4"/>}
  {name === 'github' && <path d="M9 19c-4 1.2-4-2-6-2.5M15 22v-3.1c0-.9.3-1.5.6-1.8 2.3-.3 4.7-1.1 4.7-5.2a4.1 4.1 0 0 0-1.1-2.8c.1-.3.5-1.4-.1-2.9 0 0-.9-.3-2.9 1.1a10 10 0 0 0-5.3 0C8.8 5.9 8 6.2 8 6.2c-.6 1.5-.2 2.6-.1 2.9a4.1 4.1 0 0 0-1.1 2.8c0 4.1 2.4 4.9 4.7 5.2-.3.3-.5.8-.6 1.5V22M4.4 20a10 10 0 1 1 15.2 0"/>}
  {name === 'macos' && <><rect x="3" y="4" width="18" height="13" rx="2"/><path d="M8 21h8m-4-4v4"/></>}
  {name === 'ubuntu' && <><circle cx="12" cy="12" r="7"/><circle cx="5" cy="12" r="2" fill="var(--paper)"/><circle cx="15.5" cy="6" r="2" fill="var(--paper)"/><circle cx="15.5" cy="18" r="2" fill="var(--paper)"/></>}
  {name === 'windows' && <path d="M4 6.5 20 4v16L4 17.5zm7 11.9V5.6M4 12h16"/>}
</svg>
