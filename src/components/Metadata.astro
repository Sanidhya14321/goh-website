---
import { path, siteRoutes, type SitePage } from '../lib/site';

const { title, description, page } = Astro.props as {
  title: string;
  description: string;
  page: SitePage;
};
const canonical = Astro.site && page !== 'not-found' ? new URL(path(siteRoutes[page]), Astro.site) : undefined;
const image = Astro.site && canonical ? new URL(path('social.png'), Astro.site) : undefined;
const imageAlt = 'GoHarness, a local-first coding agent, alongside its terminal interface.';
---
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="theme-color" content="#181715" />
<link rel="icon" href={path('icon.svg')} type="image/svg+xml" />
{canonical && image ? (
  <>
    <link rel="canonical" href={canonical.href} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="GoHarness" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={image.href} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image.href} />
    <meta name="twitter:image:alt" content={imageAlt} />
  </>
) : <meta name="robots" content="noindex, follow" />}
