---
const { label, command } = Astro.props as { label: string; command: string };
---
<div class="command" data-command>
  <div class="command-heading">
    <h3>{label}</h3>
    <button class="button secondary copy-command" type="button" aria-label={`Copy commands for ${label}`} hidden>Copy</button>
  </div>
  <pre tabindex="0" aria-label={label}><code>{command}</code></pre>
  <p class="command-status" role="status"></p>
</div>
