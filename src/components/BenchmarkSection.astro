---
import Bars from './Bars.astro';
import { categoryLabels, solveRate, type BenchmarkSection } from '../lib/benchmarks';
const { section, anchor } = Astro.props as { section: BenchmarkSection; anchor: string };
const { result } = section;
const models = result.kind === 'live-solves' ? [...new Set(result.rows.map(({ model }) => model))] : [];
const numeric = new Intl.NumberFormat('en-US');
---
<section class="report-section" id={anchor} aria-labelledby={`${anchor}-title`}>
  <div class="report-heading">
    <div>
      <h4 id={`${anchor}-title`}>{section.title}</h4>
      <p>{section.description}</p>
    </div>
    <p class="measurement-type">{categoryLabels[result.kind].split(' · ')[0]}</p>
  </div>
  {result.kind === 'live-solves' ? (
    <>
      {models.length > 1 && <div class="benchmark-filter" data-model-filter hidden>
        <label for={`${anchor}-model`}>Filter by model</label>
        <select id={`${anchor}-model`}>
          <option value="">All models</option>
          {models.map((model) => <option value={model}>{model}</option>)}
        </select>
        <span role="status"></span>
      </div>}
      <Bars title="Share of attempts solved" values={result.rows.map((row) => ({
        label: row.name, value: solveRate(row.solved, row.attempts), detail: `${row.solved}/${row.attempts} · ${row.model}`, model: row.model,
      }))} maximum={100} unit="%" endpoint="100%" />
      <div class="table-scroll" role="region" aria-labelledby={`${anchor}-caption`} tabindex="0">
        <table class="solve-table">
          <caption id={`${anchor}-caption`}>Published results by run</caption>
          <thead><tr>{['Run', 'Harness', 'Model', 'Tasks', 'Attempts', 'Solved', 'False completions', 'Tool calls', 'Time (s)'].map((label) => <th scope="col">{label}</th>)}</tr></thead>
          <tbody>{result.rows.map((row) => (
            <tr data-benchmark-model={row.model}>
              <th scope="row">{row.name}</th><td>{row.harness}</td><td><code>{row.model}</code></td>
              <td>{row.taskCount} <small>{row.taskNotes}</small></td><td>{row.attempts}</td>
              <td class="result-number">{row.solved} ({solveRate(row.solved, row.attempts)}%)</td>
              <td>{row.falseCompletions}</td><td>{row.toolCalls.toFixed(1)}</td><td>{row.seconds}</td>
            </tr>
          ))}</tbody>
        </table>
      </div>
      <p class="report-note">{result.grading} Percentages are rounded from the attempt counts.</p>
    </>
  ) : (
    <>
      {result.charts?.length && <div class="comparison-charts">{result.charts.map((chart) => {
        const values = chart.columns.map((column) => ({ label: result.columnLabels[column], value: Number(result.rows[chart.row][column]) }));
        return <Bars title={chart.title} values={values} maximum={Math.max(...values.map(({ value }) => value))} unit={chart.unit} decimals={chart.decimals} compact={result.kind === 'live-efficiency'} />;
      })}</div>}
      <div class="table-scroll" role="region" aria-labelledby={`${anchor}-caption`} tabindex="0">
        <table>
          <caption id={`${anchor}-caption`}>{section.title} results</caption>
          <thead><tr>{result.columnLabels.map((label) => <th scope="col">{label}</th>)}</tr></thead>
          <tbody>{result.rows.map(([name, ...cells]) => <tr><th scope="row">{name}</th>{cells.map((cell) => <td>{typeof cell === 'number' ? numeric.format(cell) : cell}</td>)}</tr>)}</tbody>
        </table>
      </div>
    </>
  )}
  <details class="method">
    <summary>Methodology and sources</summary>
    <div class="disclosure-content">
      <p>{section.methodology}</p>
      {section.note && <p>{section.note}</p>}
      <ul>{section.sources.map(({ url, label }) => <li><a href={url}>{label}</a></li>)}</ul>
    </div>
  </details>
</section>
