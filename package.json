{
  "name": "goh-website",
  "version": "1.0.0",
  "description": "GoHarness benchmarks and desktop downloads",
  "scripts": {
    "test": "node --disable-warning=ExperimentalWarning --test scripts/*.test.ts",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "refresh:downloads": "node scripts/refresh-downloads.ts",
    "test:build": "node scripts/verify-build.ts",
    "refresh:engine": "node scripts/refresh-engine.ts",
    "build:vercel": "npm run refresh:engine && npm run refresh:downloads && astro build"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "astro": "^7.4.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/node": "^22.20.5",
    "typescript": "^6.0.3"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  }
}
